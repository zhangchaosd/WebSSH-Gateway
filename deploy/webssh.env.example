WEBSSH_LISTEN=127.0.0.1:8080
WEBSSH_DATA_DIR=/var/lib/webssh
WEBSSH_DATABASE=/var/lib/webssh/webssh.db
WEBSSH_MASTER_KEY_FILE=/etc/webssh/master.key
WEBSSH_PUBLIC_URL=https://ssh.example.lan
WEBSSH_ALLOWED_ORIGINS=https://ssh.example.lan
WEBSSH_COOKIE_SECURE=true
WEBSSH_SESSION_IDLE_TIMEOUT=8h
WEBSSH_CONNECT_TIMEOUT=10s
WEBSSH_HANDSHAKE_TIMEOUT=15s
WEBSSH_KEEPALIVE_INTERVAL=30s
WEBSSH_MAX_WS_MESSAGE_BYTES=1048576
WEBSSH_MAX_SESSIONS_PER_USER=10
WEBSSH_MAX_SESSIONS_TOTAL=50
WEBSSH_DEFAULT_TERM=xterm-256color
